{
  "name": "eminence-api",
  "version": "1.0.0",
  "description": "Eminence Life Science — Express/PostgreSQL API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:002": "node src/db/migrate_002_expand_catalog.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:002": "node src/db/seed_002_new_products.js",
    "db:reset": "node src/db/migrate.js && node src/db/seed.js",
    "db:expand": "node src/db/migrate_002_expand_catalog.js && node src/db/seed_002_new_products.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "express-validator": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.12.0",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "nodemon": "3.1.4"
  }
}
